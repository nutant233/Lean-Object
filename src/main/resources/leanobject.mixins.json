  "compatibilityLevel": "JAVA_21",
  "mixins": [
    "aekey.AEFluidKeyAccess",
    "aekey.AEFluidKeyMixin",
    "aekey.AEItemKeyAccess",
    "aekey.AEItemKeyMixin",
    "aekey.FluidMixin",
    "aekey.ItemMixin",
    "ingredient.IngredientMixin",
    "ingredient.ItemMixin",
    "ingredient.TagKeyMixin",
    "nbt.CompoundTagMixin",
